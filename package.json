{
  "name": "@evently/backend",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "prisma generate && next build",
    "start": "next start -p 4000",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:cleanup": "tsx --env-file=.env scripts/cleanup.ts"
  },
  "dependencies": {
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "7.10.1",
    "prisma": "7.10.1",
    "zod": "^4.1.12",
    "bcryptjs": "^3.0.2",
    "nodemailer": "^10.3.1",
    "csv-parse": "^7.0.3",
    "date-fns-tz": "^3.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2"
  }
}
